
# Example .env file - copy to .env and fill values (don't commit secrets to git)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/learning_scheduler?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_db_password

APP_JWT_SECRET=replace_with_a_long_random_string
APP_JWT_EXPIRATION_MS=86400000

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
